# Copy to `.env` (git-ignored) next to docker-compose.yml and replace every `change-me`.
# Generate a password with e.g.:  openssl rand -hex 24
# Use letters and digits only: the password is also embedded in a database URL.

# Port on the host where the web UI, /api and /mcp are published (Docker Compose).
WEB_PORT=8080

# PostgreSQL credentials, used by the `db` container and by `api` to build its
# DATABASE_URL (host `db`). Changing them after the first start does not change the
# existing database; see README "Upgrading".
POSTGRES_USER=expense_gauge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=expense_gauge

# Session cookie. Keep false while the app is served over plain HTTP on localhost/LAN;
# set true only behind an HTTPS reverse proxy, otherwise the browser drops the cookie.
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Seconds every failed login waits before it is answered.
LOGIN_FAILURE_DELAY_SECONDS=1.0

# Local backend run without Docker only (Docker Compose builds its own URL from the
# POSTGRES_* values above). `postgresql://` and `postgresql+psycopg://` are both accepted.
DATABASE_URL=postgresql+psycopg://expense_gauge:change-me@localhost:5432/expense_gauge

# Backend tests only. When unset, the tests start an embedded PostgreSQL themselves.
# The database name must contain "test": its public schema is dropped and recreated.
# TEST_DATABASE_URL=postgresql+psycopg://expense_gauge:change-me@localhost:5432/expense_gauge_test

# Copy to `.env` (git-ignored) and change the password.

# PostgreSQL credentials (used by the `db` container and to build DATABASE_URL)
POSTGRES_USER=expense_gauge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=expense_gauge

# Backend. `postgresql://` and `postgresql+psycopg://` are both accepted.
# Inside Docker Compose the host is `db`; for a local run use `localhost`.
DATABASE_URL=postgresql+psycopg://expense_gauge:change-me@localhost:5432/expense_gauge

# Session cookie. Keep false while the app is served over plain HTTP on localhost/LAN;
# set true only behind an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Seconds every failed login waits before it is answered.
LOGIN_FAILURE_DELAY_SECONDS=1.0

# Backend tests only. When unset, the tests start an embedded PostgreSQL themselves.
# The database name must contain "test": its public schema is dropped and recreated.
# TEST_DATABASE_URL=postgresql+psycopg://expense_gauge:change-me@localhost:5432/expense_gauge_test
